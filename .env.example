# Copy to .env and fill in from your access page (https://mcp-hackathon.sherpaswealth.com/personal-token).
# .env is git-ignored. Never commit it or put these values in the web app.
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=

# Optional
# CASES_SOURCE=local          # read cases/ only; by default the Sherpas MCP is used when MCP_TOKEN is set
# TEXT_MODEL=gpt-5-mini
# TEXT_REASONING=low          # minimal is faster but follows brevity rules less well
# TTS_MODEL=eleven-flash-v2.5
# TTS_VOICE=alloy
# TEXT_BUDGET_USD=2           # spend caps; past them the app falls back instead of failing
# TTS_BUDGET_USD=1            # the team shares $1.40 of ElevenLabs
# VOICE_MODEL=gpt-realtime-2.1-mini,gemini-3.8-live   # read-aloud fallback when ElevenLabs is down, tried in order
# VOICE_BUDGET_USD=3
